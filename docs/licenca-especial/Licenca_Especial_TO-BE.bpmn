<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definicoes_LicencaEspecial" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn_tobe.py" exporterVersion="1.0">
  <collaboration id="Colaboracao_1">
    <participant id="Piscina_1" name="Licença especial – processo proposto (TO-BE)" processRef="Processo_1"/>
  </collaboration>
  <process id="Processo_1" name="Licença especial (TO-BE)" isExecutable="false">
    <laneSet id="Raias_1">
      <lane id="Raia_1" name="Aspirante">
        <flowNodeRef>Inicio</flowNodeRef>
        <flowNodeRef>T1</flowNodeRef>
        <flowNodeRef>T8</flowNodeRef>
        <flowNodeRef>G2</flowNodeRef>
        <flowNodeRef>FimNegado</flowNodeRef>
        <flowNodeRef>Prazo1700</flowNodeRef>
      </lane>
      <lane id="Raia_2" name="Encarregado de Licenças">
        <flowNodeRef>Prazo1230</flowNodeRef>
        <flowNodeRef>T2</flowNodeRef>
        <flowNodeRef>T7</flowNodeRef>
        <flowNodeRef>T10</flowNodeRef>
        <flowNodeRef>Fim</flowNodeRef>
      </lane>
      <lane id="Raia_3" name="ComPel (Asp)">
        <flowNodeRef>T3</flowNodeRef>
        <flowNodeRef>G1</flowNodeRef>
        <flowNodeRef>T4</flowNodeRef>
      </lane>
      <lane id="Raia_4" name="ComCia (Asp)">
        <flowNodeRef>T5</flowNodeRef>
      </lane>
      <lane id="Raia_5" name="ComCia (Tenente)">
        <flowNodeRef>T6</flowNodeRef>
      </lane>
      <lane id="Raia_6" name="Polícia">
        <flowNodeRef>T9</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Inicio" name="Licença especial desejada">
      <outgoing>F1</outgoing>
    </startEvent>
    <task id="T1" name="Registrar o pedido (até 12h30)">
      <incoming>F1</incoming>
      <outgoing>F2</outgoing>
    </task>
    <intermediateCatchEvent id="Prazo1230" name="12h30: fim dos pedidos">
      <incoming>F2</incoming>
      <outgoing>F3</outgoing>
      <timerEventDefinition id="Prazo1230_Def"/>
    </intermediateCatchEvent>
    <task id="T2" name="Consolidar e conferir os pedidos (até 13h30)">
      <incoming>F3</incoming>
      <outgoing>F4</outgoing>
    </task>
    <task id="T3" name="Tomar ciência da relação (até 14h00)">
      <incoming>F4</incoming>
      <outgoing>F5</outgoing>
    </task>
    <exclusiveGateway id="G1" name="Há impedimento?">
      <incoming>F5</incoming>
      <outgoing>F6</outgoing>
      <outgoing>F7</outgoing>
    </exclusiveGateway>
    <task id="T4" name="Registrar o veto, com motivo">
      <incoming>F6</incoming>
      <outgoing>F8</outgoing>
    </task>
    <task id="T5" name="Revisar a RDLE e dar o visto (até 15h00)">
      <incoming>F7</incoming>
      <incoming>F8</incoming>
      <outgoing>F9</outgoing>
    </task>
    <task id="T6" name="Aprovar a RDLE em lote (até 16h00)">
      <incoming>F9</incoming>
      <outgoing>F10</outgoing>
    </task>
    <task id="T7" name="Publicar a RDLE e enviar ao Polícia (16h30)">
      <incoming>F10</incoming>
      <outgoing>F11</outgoing>
    </task>
    <task id="T8" name="Consultar o resultado">
      <incoming>F11</incoming>
      <outgoing>F12</outgoing>
    </task>
    <exclusiveGateway id="G2" name="Pedido aprovado?">
      <incoming>F12</incoming>
      <outgoing>F13</outgoing>
      <outgoing>F14</outgoing>
    </exclusiveGateway>
    <endEvent id="FimNegado" name="Pedido negado, com motivo">
      <incoming>F13</incoming>
    </endEvent>
    <intermediateCatchEvent id="Prazo1700" name="17h00">
      <incoming>F14</incoming>
      <outgoing>F15</outgoing>
      <timerEventDefinition id="Prazo1700_Def"/>
    </intermediateCatchEvent>
    <task id="T9" name="Conferir a identidade e registrar a saída">
      <incoming>F15</incoming>
      <outgoing>F16</outgoing>
    </task>
    <task id="T10" name="Baixar o saldo (dia seguinte, até 08h00)">
      <incoming>F16</incoming>
      <outgoing>F17</outgoing>
    </task>
    <endEvent id="Fim" name="Licença registrada">
      <incoming>F17</incoming>
    </endEvent>
    <sequenceFlow id="F1" sourceRef="Inicio" targetRef="T1"/>
    <sequenceFlow id="F2" sourceRef="T1" targetRef="Prazo1230"/>
    <sequenceFlow id="F3" sourceRef="Prazo1230" targetRef="T2"/>
    <sequenceFlow id="F4" sourceRef="T2" targetRef="T3"/>
    <sequenceFlow id="F5" sourceRef="T3" targetRef="G1"/>
    <sequenceFlow id="F6" name="Sim" sourceRef="G1" targetRef="T4"/>
    <sequenceFlow id="F7" name="Não" sourceRef="G1" targetRef="T5"/>
    <sequenceFlow id="F8" sourceRef="T4" targetRef="T5"/>
    <sequenceFlow id="F9" sourceRef="T5" targetRef="T6"/>
    <sequenceFlow id="F10" sourceRef="T6" targetRef="T7"/>
    <sequenceFlow id="F11" sourceRef="T7" targetRef="T8"/>
    <sequenceFlow id="F12" sourceRef="T8" targetRef="G2"/>
    <sequenceFlow id="F13" name="Não" sourceRef="G2" targetRef="FimNegado"/>
    <sequenceFlow id="F14" name="Sim" sourceRef="G2" targetRef="Prazo1700"/>
    <sequenceFlow id="F15" sourceRef="Prazo1700" targetRef="T9"/>
    <sequenceFlow id="F16" sourceRef="T9" targetRef="T10"/>
    <sequenceFlow id="F17" sourceRef="T10" targetRef="Fim"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagrama_1" name="Processo proposto (TO-BE)">
    <bpmndi:BPMNPlane id="Plano_1" bpmnElement="Colaboracao_1">
