      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="451" y="434" width="42" height="42"/><bpmndi:BPMNLabel><dc:Bounds x="427" y="407" width="90" height="24"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="529" y="419" width="118" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="529" y="522" width="118" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T6_di" bpmnElement="T6"><dc:Bounds x="529" y="622" width="118" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T7_di" bpmnElement="T7"><dc:Bounds x="661" y="300" width="118" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T8_di" bpmnElement="T8"><dc:Bounds x="661" y="100" width="118" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_di" bpmnElement="G2" isMarkerVisible="true"><dc:Bounds x="808" y="115" width="42" height="42"/><bpmndi:BPMNLabel><dc:Bounds x="784" y="160" width="90" height="24"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FimNegado_di" bpmnElement="FimNegado"><dc:Bounds x="922" y="62" width="32" height="32"/><bpmndi:BPMNLabel><dc:Bounds x="960" y="64" width="90" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Prazo1700_di" bpmnElement="Prazo1700"><dc:Bounds x="922" y="120" width="32" height="32"/><bpmndi:BPMNLabel><dc:Bounds x="960" y="122" width="90" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
