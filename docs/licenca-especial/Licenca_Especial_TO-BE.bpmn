      <bpmndi:BPMNShape id="Raia_6_di" bpmnElement="Raia_6" isHorizontal="true"><dc:Bounds x="32" y="608" width="1192" height="100"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Inicio_di" bpmnElement="Inicio"><dc:Bounds x="103" y="120" width="32" height="32"/><bpmndi:BPMNLabel><dc:Bounds x="74" y="155" width="90" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="165" y="100" width="118" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Prazo1230_di" bpmnElement="Prazo1230"><dc:Bounds x="208" y="320" width="32" height="32"/><bpmndi:BPMNLabel><dc:Bounds x="179" y="355" width="90" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="297" y="300" width="118" height="72"/></bpmndi:BPMNShape>
